@Terminus.WebApi_HostAddress = http://localhost:5183
# Id prijevoznika (GET /api/agencies; prvi se stvara iz konfiguracije Agency:*)
@agencyId = 00000000-0000-0000-0000-000000000000
@stopId = 00000000-0000-0000-0000-000000000000
@routeId = 00000000-0000-0000-0000-000000000000
@calendarId = 00000000-0000-0000-0000-000000000000
@tripId = 00000000-0000-0000-0000-000000000000
# Dva stajališta ili perona (ne kolodvori) za primjer vremena vožnje
@stopAId = 00000000-0000-0000-0000-000000000000
@stopBId = 00000000-0000-0000-0000-000000000000

### Popis agencija
GET {{Terminus.WebApi_HostAddress}}/api/agencies?search=&page=1&pageSize=20
Accept: application/json

### Nova agencija (timezone i lang su opcionalni: Europe/Zagreb, hr)
POST {{Terminus.WebApi_HostAddress}}/api/agencies
Content-Type: application/json

{
  "name": "Test prijevoznik",
  "url": "https://example.com",
  "phone": "+385 31 000 000",
  "email": "info@example.com"
}

### Jedna agencija
GET {{Terminus.WebApi_HostAddress}}/api/agencies/{{agencyId}}
Accept: application/json

### Izmjena agencije
PUT {{Terminus.WebApi_HostAddress}}/api/agencies/{{agencyId}}
Content-Type: application/json

{
  "name": "Test prijevoznik d.o.o.",
  "url": "https://example.com",
  "timezone": "Europe/Zagreb",
  "lang": "hr"
}

### Brisanje agencije (409 ako ima linije)
DELETE {{Terminus.WebApi_HostAddress}}/api/agencies/{{agencyId}}

### Popis stanica (pretraga, filteri, straničenje)
GET {{Terminus.WebApi_HostAddress}}/api/stops?search=osijek&page=1&pageSize=20
Accept: application/json

### Jedna stanica
GET {{Terminus.WebApi_HostAddress}}/api/stops/{{stopId}}
Accept: application/json

### Novi kolodvor
POST {{Terminus.WebApi_HostAddress}}/api/stops
Content-Type: application/json

{
  "code": "OS-AK",
  "name": "Osijek, Autobusni kolodvor",
  "latitude": 45.5531,
  "longitude": 18.6955,
  "locationType": 1,
  "wheelchairBoarding": 1
}

### Novi peron (parentStationId = id kolodvora)
POST {{Terminus.WebApi_HostAddress}}/api/stops
Content-Type: application/json

{
  "code": "OS-AK-3",
  "name": "Osijek, Autobusni kolodvor",
  "latitude": 45.5532,
  "longitude": 18.6957,
  "locationType": 0,
  "parentStationId": "{{stopId}}",
  "platformCode": "3"
}

### Izmjena stanice (PUT zamjenjuje sva polja)
PUT {{Terminus.WebApi_HostAddress}}/api/stops/{{stopId}}
Content-Type: application/json

{
  "code": "OS-AK",
  "name": "Osijek, Autobusni kolodvor",
  "latitude": 45.5531,
  "longitude": 18.6955,
  "locationType": 1,
  "wheelchairBoarding": 1,
  "isActive": true
}

### Brisanje stanice
DELETE {{Terminus.WebApi_HostAddress}}/api/stops/{{stopId}}

### Popis linija (opcionalno ?agencyId= za jednog prijevoznika)
GET {{Terminus.WebApi_HostAddress}}/api/routes?search=&page=1&pageSize=20
Accept: application/json

### Nova linija (routeType 3 = autobus je zadan, boja može s # ili bez)
POST {{Terminus.WebApi_HostAddress}}/api/routes
Content-Type: application/json

{
  "agencyId": "{{agencyId}}",
  "code": "OS-DJ",
  "shortName": "12",
  "longName": "Osijek - Đakovo",
  "color": "#1565c0",
  "textColor": "FFFFFF",
  "sortOrder": 10
}

### Jedna linija
GET {{Terminus.WebApi_HostAddress}}/api/routes/{{routeId}}
Accept: application/json

### Izmjena linije
PUT {{Terminus.WebApi_HostAddress}}/api/routes/{{routeId}}
Content-Type: application/json

{
  "agencyId": "{{agencyId}}",
  "code": "OS-DJ",
  "shortName": "12",
  "longName": "Osijek - Đakovo (preko Čepina)",
  "color": "1565C0",
  "textColor": "FFFFFF",
  "sortOrder": 10,
  "isActive": true
}

### Brisanje linije (kaskadno briše i njezine vožnje)
DELETE {{Terminus.WebApi_HostAddress}}/api/routes/{{routeId}}

### Popis kalendara
GET {{Terminus.WebApi_HostAddress}}/api/calendars?search=&page=1&pageSize=20
Accept: application/json

### Novi kalendar: radni dani 2026.
POST {{Terminus.WebApi_HostAddress}}/api/calendars
Content-Type: application/json

{
  "code": "RD-2026",
  "name": "Radni dan",
  "monday": true,
  "tuesday": true,
  "wednesday": true,
  "thursday": true,
  "friday": true,
  "startDate": "2026-01-01",
  "endDate": "2026-12-31"
}

### Jedan kalendar
GET {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}
Accept: application/json

### Izmjena kalendara
PUT {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}
Content-Type: application/json

{
  "code": "RD-2026",
  "name": "Radni dan (osim praznika)",
  "monday": true,
  "tuesday": true,
  "wednesday": true,
  "thursday": true,
  "friday": true,
  "startDate": "2026-01-01",
  "endDate": "2026-12-31"
}

### Iznimke kalendara
GET {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}/dates
Accept: application/json

### Iznimka: Božić ne vozi (2 = ne vozi)
PUT {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}/dates/2026-12-25
Content-Type: application/json

{
  "exceptionType": 2
}

### Iznimka: dodatna subota vozi (1 = vozi)
PUT {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}/dates/2026-12-19
Content-Type: application/json

{
  "exceptionType": 1
}

### Brisanje iznimke
DELETE {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}/dates/2026-12-25

### Brisanje kalendara (409 ako ga koriste vožnje)
DELETE {{Terminus.WebApi_HostAddress}}/api/calendars/{{calendarId}}

### Popis vožnji (poredano po prvom polasku; filteri routeId, serviceCalendarId, directionId)
GET {{Terminus.WebApi_HostAddress}}/api/trips?routeId={{routeId}}&page=1&pageSize=20
Accept: application/json

### Nova vožnja
POST {{Terminus.WebApi_HostAddress}}/api/trips
Content-Type: application/json

{
  "routeId": "{{routeId}}",
  "serviceCalendarId": "{{calendarId}}",
  "code": "OS-DJ-0615",
  "headsign": "Đakovo",
  "directionId": 0,
  "wheelchairAccessible": 1
}

### Jedna vožnja
GET {{Terminus.WebApi_HostAddress}}/api/trips/{{tripId}}
Accept: application/json

### Izmjena vožnje
PUT {{Terminus.WebApi_HostAddress}}/api/trips/{{tripId}}
Content-Type: application/json

{
  "routeId": "{{routeId}}",
  "serviceCalendarId": "{{calendarId}}",
  "code": "OS-DJ-0615",
  "headsign": "Đakovo AK",
  "directionId": 0,
  "wheelchairAccessible": 1,
  "bikesAllowed": 2
}

### Stanice i vremena vožnje
GET {{Terminus.WebApi_HostAddress}}/api/trips/{{tripId}}/stop-times
Accept: application/json

### Postavi stanice i vremena (zamjenjuje cijeli popis; departureTime je opcionalan)
PUT {{Terminus.WebApi_HostAddress}}/api/trips/{{tripId}}/stop-times
Content-Type: application/json

{
  "stopTimes": [
    { "stopId": "{{stopAId}}", "arrivalTime": "06:15:00" },
    { "stopId": "{{stopBId}}", "arrivalTime": "07:05:00", "departureTime": "07:05:00" }
  ]
}

### Brisanje vožnje (briše i njezina vremena)
DELETE {{Terminus.WebApi_HostAddress}}/api/trips/{{tripId}}

###

### GTFS izvoz (ZIP; 422 s popisom problema ako feed nije spreman)
GET {{Terminus.WebApi_HostAddress}}/api/gtfs

###

### Sljedeći polasci sa stanice (javno; kod kolodvora uključuje sve perone)
GET {{Terminus.WebApi_HostAddress}}/api/public/departures/OS-AK?limit=10
Accept: application/json

###
